# Copy to ci/.env and fill credentials using the authorized secret manager.
WOODPECKER_HOST=https://viniciusmenezes.com/ci
WOODPECKER_ADMIN=
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
WOODPECKER_AGENT_SECRET=

# Woodpecker control API exporter (token content lives in a separate 0600 file).
CI_WOODPECKER_REPO_ID=
CI_WOODPECKER_TOKEN_FILE=/etc/python-demo/woodpecker-api-token
