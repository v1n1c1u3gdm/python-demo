{
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "**/.venv/**", "**/venv/**", "**/dist/**", "**/coverage/**", ".superpowers/**"],
  "config": {
    "MD013": {
      "line_length": 120,
      "code_blocks": false,
      "tables": false
    },
    "MD024": {
      "siblings_only": true
    }
  }
}
